# Copy to deploy/.env (gitignored) and fill in. Never commit the real file.

# Your domain, with DNS pointing at this server. Caddy gets its HTTPS certificate for it.
SITE_ADDRESS=fittracker.example.com

# Path to the fitness-tracker-ui folder, relative to this deploy/ folder.
FRONTEND_PATH=../../fitness-tracker-ui

# Database passwords: long random strings (e.g. `openssl rand -base64 24`).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Gmail account used for password-reset and notification emails (use an App Password).
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Optional: Google sign-in. Create an OAuth 2.0 Web client in Google Cloud Console, add
# https://your-domain as an authorised JavaScript origin, and paste the client ID here.
# Leave it empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# Optional: FitTracker Ultimate payments with M-Pesa, Mixx by Yas, Airtel Money and HaloPesa.
# From the ClickPesa dashboard: Settings > Developers > create an application. Set its webhook to
# https://your-domain/api/billing/clickpesa/webhook. Prices are in Tanzanian shillings.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
ULTIMATE_MONTHLY_TZS=10000
ULTIMATE_YEARLY_TZS=100000

# Optional: preview mode shows the Ultimate payment UI even while ClickPesa isn't configured yet.
# Keep it false when the site is live.
BILLING_PREVIEW_MODE=false
